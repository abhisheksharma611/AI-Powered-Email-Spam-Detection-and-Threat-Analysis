FLASK_SECRET_KEY=your-flask-secret-key-here
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
FLASK_ENV=development
DEBUG=True

ADMIN_EMAILS=admin@example.com

# Kaggle API Credentials
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key

SERVER_NAME=localhost:5000
PREFERRED_URL_SCHEME=http

# Local Ollama AI explanation — OPTIONAL, runs entirely on your machine.
# Not running? Summaries are skipped silently; the app is unaffected.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT=90
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=100
OLLAMA_KEEP_ALIVE=5m

# ─────────────────────────────────────────────────────────────────────────────
# EXPERIMENT — Laya, dashboard "Test Text" modal only.
#
# Laya is a separate runtime from Ollama and listens on its own port, so these
# do not collide with the OLLAMA_* block above. Ollaya serves the model;
# Ollama (11434) still writes the narrative explanations.
#
# The Test Text button posts to /api/laya_text and is answered by Laya alone.
# Everything else — Start Analysis, the inbox scan, /api/analyze_text — still
# uses RoBERTa + ensemble and ignores these entirely.
#
# Not running? The modal says "Laya is not available right now" and returns
# 503. It does NOT fall back to RoBERTa, because the card is labelled Laya.
# Start Ollaya (`ollaya serve`) to use the button.
# ─────────────────────────────────────────────────────────────────────────────
LAYA_BASE_URL=http://localhost:11435
LAYA_MODEL=laya:en
LAYA_TIMEOUT=60
LAYA_KEEP_ALIVE=15m
LAYA_MAX_CHARS=1400

# Which engine classifies email. 'roberta' (default) = fine-tuned RoBERTa 0.90
# + sklearn ensemble 0.10, both loaded from models/. 'laya' = Laya only; the
# 498 MB checkpoint and 111 MB ensemble are NOT loaded at all.
#
# The artefacts are never deleted either way. Switching back to roberta is a
# one-line change with no retraining.
#
# 'laya' is one HTTP request per email and cannot batch, so a 50-email inbox
# scan takes roughly 50 x 66ms of model time (~3.3s) instead of the batched
# GPU path. Acceptable for an experiment; not what you want in production.
#
# Measured accuracy on 30 labelled samples: Laya 73%, RoBERTa 96.7%.
PREDICTOR_BACKEND=roberta

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — nothing below is required for the app to run.
#
# Per-mail AI summaries are served by LOCAL OLLAMA (see OLLAMA_* above). If
# Ollama is not running, summaries are skipped silently and the app works fine.
# Leave the OLLAMA_* defaults alone unless you want a different local model.
#
# The NVIDIA NIM block below is an ALTERNATIVE cloud backend. The matching
# function in utils/ai_explanation.py is fully commented out — setting these
# variables changes nothing until that code is re-enabled. Kept for reference.
# ─────────────────────────────────────────────────────────────────────────────
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key
# NVIDIA_NIM_MODEL=nvidia/nemotron-3-nano-30b-a3b
