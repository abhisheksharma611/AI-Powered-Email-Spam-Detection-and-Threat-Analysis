FLASK_SECRET_KEY=your-flask-secret-key-here
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
FLASK_ENV=development
DEBUG=True

ADMIN_EMAILS=admin@example.com

# Kaggle API Credentials
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key

SERVER_NAME=localhost:5000
PREFERRED_URL_SCHEME=http

# Local Ollama AI explanation — OPTIONAL, runs entirely on your machine.
# Not running? Summaries are skipped silently; the app is unaffected.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_TIMEOUT=90
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=100
OLLAMA_KEEP_ALIVE=5m

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — nothing below is required for the app to run.
#
# Per-mail AI summaries are served by LOCAL OLLAMA (see OLLAMA_* above). If
# Ollama is not running, summaries are skipped silently and the app works fine.
# Leave the OLLAMA_* defaults alone unless you want a different local model.
#
# The NVIDIA NIM block below is an ALTERNATIVE cloud backend. The matching
# function in utils/ai_explanation.py is fully commented out — setting these
# variables changes nothing until that code is re-enabled. Kept for reference.
# ─────────────────────────────────────────────────────────────────────────────
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key
# NVIDIA_NIM_MODEL=nvidia/nemotron-3-nano-30b-a3b
